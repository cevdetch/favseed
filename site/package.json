{
  "name": "favseed-site",
  "private": true,
  "description": "favseed in the browser: the same engine and bytes as the CLI, nothing uploaded.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "icons": "node ../bin/favseed.mjs",
    "test": "node --test test/worker.mjs",
    "test:browser": "playwright test",
    "build": "astro build && deadhead dist --fail-on=harmful",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/image-wasm32-wasi": "1.15.0",
    "@napi-rs/wasm-runtime": "1.2.5",
    "astro": "^7.3.8",
    "buffer": "^6.0.3",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "deadhead": "0.3.1"
  }
}

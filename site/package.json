{
  "name": "favseed-site",
  "private": true,
  "description": "favseed in the browser: the same engine and bytes as the CLI, nothing uploaded.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "icons": "node ../bin/favseed.mjs",
    "test": "node --test test/worker.mjs test/sections.mjs",
    "test:browser": "playwright test",
    "test:dist": "node --test test/seo.mjs",
    "build": "node build/unshallow.mjs && astro build && deadhead dist --fail-on=harmful",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@napi-rs/wasm-runtime": "1.2.6",
    "astro": "^7.4.7",
    "buffer": "^6.0.3",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "deadhead": "0.3.1"
  }
}

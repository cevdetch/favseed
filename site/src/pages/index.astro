---
// Static page, client-side pipeline. The pipeline imports the shared engine and WASM packages,
// and something has to resolve and bundle them; the documentation pages share this page's
// layout.
import Page from '../layouts/Page.astro';

const title = 'favseed: one SVG in, an optimised favicon set out';
const description = 'Turn one SVG into favicon.ico, icon.svg, an apple-touch-icon and maskable PWA icons, quantised and recompressed. Runs in your browser; nothing is uploaded.';
const url = new URL('/', Astro.site).href;
// JSON inside <script> ends at the first "</script", so every "<" is escaped.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'favseed',
  url,
  description,
  inLanguage: 'en',
  publisher: {
    '@type': 'Person',
    '@id': 'https://cevdet.ch/#person',
    name: 'Cevdet',
    url: 'https://cevdet.ch/',
    sameAs: ['https://github.com/cevdetch'],
  },
}).replaceAll('<', '\\u003c');

const outputs = [
  ['icon.svg', 'One optimized SVG for the favicon and page images, preserving animation and styling.'],
  ['favicon.ico', 'One 48x48 entry, a raw PNG in a 22-byte container.'],
  ['apple-touch-icon.png', '180x180 on the chosen ground, the mark placed in the safe zone.'],
  ['icon-192.png, icon-512.png', 'On the same ground, placed the same way. The manifest\'s "any maskable" icons.'],
  ['site.webmanifest', 'Icons only. Merge your own name and theme_color.'],
];
---
<Page {title} {description}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

<header>
  <h1><img src="/icon.svg" alt="" width="40" height="40" />favseed</h1>
  <p>One SVG in, an optimised favicon set out.</p>
  <p><small>
    Everything below runs in this tab. There is no upload endpoint, because there is no server
    to receive one: the page is static files.
  </small></p>
</header>

<main>
  <form>
    <label class="drop">
      <input type="file" name="file" accept=".svg,image/svg+xml" required />
      <strong>Choose an SVG</strong>
      <small>or drop one here</small>
    </label>
    <label>Sizes
      <input type="text" name="sizes" value="192 512" pattern="\s*\d+([\s,]+\d+)*\s*" required />
      <small>The padded “any maskable” icons.</small>
    </label>
    <label>Ground
      <input type="text" name="bg" value="#000000" required />
      <small>Under the padded icons. <code>none</code> keeps alpha and declares them <code>any</code> only.</small>
    </label>
    <label>Padding
      <input type="text" name="padding" value="auto" pattern="\s*(auto|\d+(\.\d+)?)\s*" required />
      <small>Percent per side, or <code>auto</code> to measure the mark.</small>
    </label>
    <label>Effort
      <select name="effort">
        <option value="fast">Fast — instant, larger files</option>
        <option value="default" selected>Default — smallest passing files</option>
        <option value="max">Maximum — slowest, smallest</option>
      </select>
      <small>How hard to work on each PNG.</small>
    </label>
    <details>
      <summary>Advanced: pin a setting</summary>
      <div>
        <label>PNG quality
          <input type="number" name="quality" min="1" max="100" step="1" placeholder="Auto (recommended)" />
          <small>1–100 at the full palette. One encode, no search.</small>
        </label>
        <label>Palette
          <input type="number" name="colors" min="2" max="256" step="1" placeholder="Auto (recommended)" />
          <small>2–256 colours at quality 100. Unavailable below quality 100.</small>
        </label>
      </div>
    </details>
    <label><input type="checkbox" name="animation" checked /> Preserve SVG animation</label>
    <button type="submit">Generate</button>
    <button type="button" id="cancel" hidden>Cancel</button>
    <output aria-live="polite"></output>
  </form>
  <ul id="warnings" aria-live="polite" hidden></ul>

  <section id="result" hidden>
    <h2 id="set-title">Your set</h2>
    <figure><img id="p-light" alt="the mark on white" /><figcaption>on white</figcaption></figure>
    <figure><img id="p-dark" alt="the mark on dark" /><figcaption>on dark</figcaption></figure>
    <figure><img id="p-mask" alt="a padded icon under a circular mask" /><figcaption>masked</figcaption></figure>
    <div><table>
      <thead><tr><th>file</th><th>bytes</th><th>setting</th><th></th></tr></thead>
      <tbody id="files"></tbody>
    </table></div>
    <p><small id="fit"></small></p>
    <a id="zip" class="button" download="favseed.zip">Download .zip</a>
    <div class="head-tools">
      <h3>Add to your <code>&lt;head&gt;</code></h3>
      <button type="button" id="copy-links" hidden>Copy markup</button>
    </div>
    <p id="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <pre id="links"></pre>
  </section>

  <section>
    <h2>What you get</h2>
    <dl>
      {outputs.map(([name, what]) => (<><dt><code>{name}</code></dt><dd>{what}</dd></>))}
    </dl>
    <p><a href="/outputs">Each file in detail</a>: its format, the HTML it needs and the platforms that read it.</p>
  </section>

  <aside>
    <h2>The same files as the CLI</h2>
    <p>This page runs the same pinned image engine and build pipeline as the command line.
      Matching SVG and options produce identical SVG, PNG, ICO, and manifest
      files. Builds run in a worker so the page stays responsive; Cancel stops the build.</p>
    <p>In a four-logo benchmark using matching raster inputs, Fast’s quality-80 set used 0.5% more
      PNG/ICO bytes than Vite PWA assets-generator 2.0.0’s default, with lower measured PNG pixel
      error. <a href="https://github.com/cevdetch/favseed/blob/main/bench/ico-size/README.md">Measurements and method</a>;
      the <a href="/benchmarks">benchmarks</a> cover the default effort too.</p>
    <p>Default effort keeps, for each PNG, the smallest encode that still passes
      the <a href="/how-it-works">accuracy bar</a>, then recompresses it with Zopfli. Fast makes one quality-80 encode and skips Zopfli;
      Maximum tries every candidate and runs Zopfli longest. At Default and Maximum this page shows
      Fast’s set at once, ready to download, and replaces it when the smallest passing files are
      ready. A pinned quality or palette makes
      one encode at that setting and warns when it misses the bar. These
      match <code>--effort</code>, <code>--quality</code> and <code>--colors</code> in the CLI. This
      page includes a manifest; use <code>--manifest</code> for the matching CLI set.</p>
    <p>The engine loads after you choose a file. Its WASM is about 10.3 MB before transfer
      compression and starts with 64 MiB of growable memory. Use a recent browser on HTTPS.
      Browser privacy restrictions can select a slower compatibility mode.
      Your SVG and generated files stay in this tab.</p>
  </aside>
</main>

<Fragment slot="end">
<script>
  const $ = (id) => document.getElementById(id);
  const form = document.querySelector('form');
  const { file, quality, colors } = form.elements;
  // A quality below 100 lets the quantiser choose the palette, so the two cannot be pinned together.
  const updatePalette = () => { colors.disabled = quality.value.trim() !== '' && Number(quality.value) < 100; };
  quality.addEventListener('input', updatePalette);
  updatePalette();
  const drop = file.labels[0], go = form.querySelector('button[type=submit]'), status = form.querySelector('output');
  const cancel = $('cancel'), warnings = $('warnings'), result = $('result'), title = $('set-title'), zipLink = $('zip');
  const copy = $('copy-links'), copyStatus = $('copy-status'), links = $('links');
  const canCopy = typeof navigator.clipboard?.writeText === 'function';
  const TYPES = { svg: 'image/svg+xml', png: 'image/png', ico: 'image/x-icon', webmanifest: 'application/manifest+json' };
  // `shown` is the build whose set is on the page.
  let urls = [], active, shown, resultRevision = 0;

  copy.hidden = !canCopy;
  const resetCopyStatus = () => { copyStatus.textContent = canCopy ? '' : 'Select and copy the markup below.'; };
  resetCopyStatus();
  copy.addEventListener('click', async () => {
    if (!links.textContent || copy.getAttribute('aria-disabled') === 'true') return;
    const text = links.textContent, revision = resultRevision;
    // Keep keyboard focus while preventing duplicate requests during the write.
    copy.setAttribute('aria-disabled', 'true');
    copyStatus.textContent = '';
    try {
      await navigator.clipboard.writeText(text);
      if (revision === resultRevision) copyStatus.textContent = 'Copied head markup.';
    } catch {
      if (revision === resultRevision) copyStatus.textContent = 'Could not copy. Select and copy the markup below.';
    } finally {
      copy.removeAttribute('aria-disabled');
    }
  });

  const say = (msg, kind = '') => { status.textContent = msg; status.className = kind; };

  // Fetch the engine only after choosing a file, overlapping initialization with options.
  let pipeline;
  const load = () => (pipeline ??= import('../lib/pipeline.mjs').catch((e) => { pipeline = null; throw e; }));
  const warm = () => load().then((m) => m.warm()).catch(() => {});   // reported by the submit that awaits load

  // The input covers the drop zone, so the browser does the picking and the dropping; all that
  // is left here is the highlight while something is dragged over it.
  for (const [type, on] of [['dragenter', true], ['dragleave', false], ['drop', false]]) {
    file.addEventListener(type, () => drop.classList.toggle('over', on));
  }
  file.addEventListener('change', () => {
    const f = file.files[0];
    // `accept` filters the picker but not a drop, so a dropped PNG still arrives here.
    const ok = f && (/\.svg$/i.test(f.name) || f.type === 'image/svg+xml');
    if (f && !ok) file.value = '';
    drop.querySelector('strong').textContent = ok ? f.name : 'Choose an SVG';
    // A new file ends the build in progress; a quick set it showed stays.
    if (active) { stop(); idle(); }
    if (!ok) return say(f ? 'That is not an SVG.' : '', f ? 'bad' : '');
    say('Ready.');
    warm();
  });

  // A raster's chosen encode, as the CLI's --quality and --colors would ask for it, and its scores.
  const setting = (q, quick) => {
    if (!q) return ['', ''];
    const { quality: n, colors: c } = q.setting;
    const label = (n < 100 || c === 256 ? `quality ${n}` : `${c} colours`) + (quick ? ' (quick)' : '');
    return [label, q.pct === null ? 'Not scored against the accuracy bar.'
      : `${q.pct.toFixed(2)} % of pixels off, edge error ${q.edge.toFixed(3)}${q.pass ? '' : ' (misses the bar)'}`];
  };

  // Shows a set, quick or final, and frees the previous one's object URLs.
  const show = (built, quick) => {
    const next = [];
    const url = (bytes, type) => {
      const u = URL.createObjectURL(new Blob([bytes], { type }));
      next.push(u);
      return u;
    };
    try {
      // Every name comes from the pipeline's fixed list, never from the visitor's file.
      $('files').innerHTML = built.files.map((f) => {
        const [label, scores] = setting(built.quality[f.name], quick);
        return `<tr><td><code>${f.name}</code></td><td>${f.bytes.length}\u00a0B</td>` +
          `<td title="${scores}">${label}</td>` +
          `<td><a download="${f.name}" href="${url(f.bytes, TYPES[f.name.split('.').pop()])}">save</a></td></tr>`;
      }).join('');

      const byName = Object.fromEntries(built.files.map((f) => [f.name, f.bytes]));
      $('p-light').src = $('p-dark').src = url(byName['icon.svg'], TYPES.svg);
      const biggest = Math.max(...Object.keys(built.fit.icons).map(Number));
      const fit = built.fit.icons[biggest];
      // The masked preview shows the largest padded icon: that is what a launcher masks.
      $('p-mask').src = fit ? url(byName[`icon-${biggest}.png`], TYPES.png) : $('p-light').src;
      $('fit').textContent = fit
        ? `Mark placed at ${fit.box}px of ${fit.canvas} in the safe zone` +
          `${fit.snapped ? ', snapped to whole pixels' : ''}` +
          `${fit.fullBleed ? ' (full-bleed source, used as drawn)' : ''}.`
        : 'No padded icon: the ground is transparent.';
      links.textContent = built.links.trim();
      resultRevision++;
      resetCopyStatus();
      zipLink.href = url(built.archive(), 'application/zip');
    } catch (e) {
      for (const u of next) URL.revokeObjectURL(u);
      throw e;
    }
    // Downloads always serve the best finished set, and say which one it is.
    title.textContent = quick ? 'Quick set — searching for smaller files…' : 'Your set';
    zipLink.textContent = quick ? 'Download the quick set (.zip)' : 'Download .zip';
    zipLink.download = quick ? 'favseed-quick.zip' : 'favseed.zip';
    result.dataset.set = quick ? 'quick' : 'final';
    result.hidden = false;
    for (const u of urls) URL.revokeObjectURL(u);
    urls = next;
    performance.mark(quick ? 'favseed:quick-set' : 'favseed:final-set');
  };
  const size = (built) => built.files.reduce((n, f) => n + f.bytes.length, 0);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    active?.abort();
    const controller = new AbortController();
    active = controller;
    const data = new FormData(form);
    const current = () => active === controller && !controller.signal.aborted;
    go.disabled = true;
    cancel.hidden = false;
    say('Building…');
    warnings.replaceChildren();
    warnings.hidden = true;
    try {
      const { buildInBrowser } = await load();
      controller.signal.throwIfAborted();
      const t0 = performance.now();
      // An empty field is Auto: it is left out, so it pins nothing and the search chooses.
      const pin = (name) => (data.get(name)?.trim() ? { [name]: data.get(name).trim() } : {});
      const built = await buildInBrowser(await data.get('file').text(), {
        ...pin('quality'),
        ...pin('colors'),
        sizes: data.get('sizes').trim().split(/[\s,]+/).map(Number),
        bg: data.get('bg').trim(),
        padding: data.get('padding').trim(),
        animation: data.has('animation'),
        effort: data.get('effort'),
      }, {
        signal: controller.signal,
        onWarn: (message) => {
          if (!current()) return;
          const item = document.createElement('li');
          item.textContent = message;
          warnings.append(item);
          warnings.hidden = false;
        },
        onEarly: (quick) => {
          if (!current()) return;
          show(quick, true);
          shown = controller;
          say('Quick set ready — searching for smaller files…');
        },
        onProgress: ({ phase, completed, total, file: name, done }) => {
          if (!current()) return;
          if (phase === 'placement') say('Placing the mark…');
          else if (phase === 'raster' && result.dataset.set !== 'quick') say(`Building images… ${completed}/${total}`);
          else if (phase === 'search') say(`Searching ${name}: ${done} of up to ${total} encodes`);
          else if (phase === 'complete') say('Preparing downloads…');
        },
      });
      controller.signal.throwIfAborted();
      const ms = Math.round(performance.now() - t0);
      show(built, false);
      shown = controller;
      const saved = built.quickBytes && Math.round(100 * (1 - size(built) / built.quickBytes));
      say(`${built.quickBytes ? `Smallest passing files ready (${saved > 0 ? `${saved} % smaller than` : 'as small as'} the quick set). ` : ''}` +
        `Done in ${ms} ms. ${built.animated ? 'icon.svg preserves its animation.' : 'The source is static.'}`, 'good');
    } catch (e) {
      if (active === controller) say(e?.name === 'AbortError' ? 'Cancelled.' : e?.message ?? String(e), e?.name === 'AbortError' ? '' : 'bad');
    } finally {
      // A quick set left behind by a stopped search stays, labelled as what it is.
      if (shown === controller && result.dataset.set === 'quick') title.textContent = 'Quick set';
      if (active === controller) idle();
    }
  });
  const idle = () => {
    active = undefined;
    go.disabled = false;
    cancel.hidden = true;
  };
  const stop = () => {
    active?.abort();
    pipeline?.then((m) => m.dispose()).catch(() => {});
  };
  cancel.addEventListener('click', stop);
  window.addEventListener('pagehide', (event) => {
    stop();
    // BFCache restores this DOM and its links; their URLs must survive with it.
    if (!event.persisted) for (const u of urls) URL.revokeObjectURL(u);
  });
</script>
</Fragment>
</Page>

{
  // Astro is an optional peerDependency (package.json's peerDependenciesMeta) so a CLI-only
  // install is not nagged about it; knip's own reference to it in astro/index.mjs is then
  // correctly "referenced", not unused, and must not fail the build the way an unused
  // dependency does.
  "rules": { "optionalPeerDependencies": "warn" },
  // The structured-data builders every cevdet.ch site installs as one shared copy. The site
  // uses a few of them; the copy is replaced whole on each install, never trimmed here.
  "ignoreIssues": { "site/src/lib/structured-data.ts": ["exports", "types"] },
  // System tools, not packages: the engine builds call rustc, clang and wasm-ld, and the
  // render and ICO tests run resvg and icotool when they are on PATH (CONTRIBUTING.md).
  "ignoreBinaries": ["rustc", "clang", "wasm-ld", "resvg", "icotool"],
  "workspaces": {
    ".": {
      "entry": ["test/*.mjs", "bench/**/*.mjs"],
      "project": ["bin/**/*.mjs", "lib/**/*.mjs", "vite/**/*.mjs", "astro/**/*.mjs", "test/**/*.mjs", "bench/**/*.mjs"],
      // The browser benchmarks drive the site with the site workspace's @playwright/test, and
      // test/astro/ is a consumer project with its own package.json that the Astro suite
      // installs; neither belongs in the package's own dependencies.
      "ignoreDependencies": ["@playwright/test", "@astrojs/node"]
    },
    "site": {
      "entry": [
        "src/pages/**/*.astro",
        "src/content.config.mjs",
        "src/lib/engine-worker.mjs",
        "test/*.mjs",
        "headers.mjs"
      ],
      "project": ["src/**/*.{mjs,ts,astro}", "test/**/*.mjs"],
      // buffer is the polyfill engine-worker.mjs installs as globalThis.Buffer for the
      // compatibility build; nothing imports it by name, so knip cannot see it is used.
      // The vendored engines in vendor/image/ import @emnapi/core, @emnapi/runtime and
      // @napi-rs/wasm-runtime directly, and knip resolves those imports on its own now that
      // image.wasi-browser.js and image.wasip1-browser.js exist in vendor/image/; listing them
      // here too would be a stale no-op, so they are left off.
      "ignoreDependencies": ["buffer"]
    }
  }
}

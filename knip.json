{
  // Astro is an optional peerDependency (package.json's peerDependenciesMeta) so a CLI-only
  // install is not nagged about it; knip's own reference to it in astro/index.mjs is then
  // correctly "referenced", not unused, and must not fail the build the way an unused
  // dependency does.
  "rules": { "optionalPeerDependencies": "warn" },
  "workspaces": {
    ".": {
      "entry": ["test/*.mjs", "bench/**/*.mjs"],
      "project": ["bin/**/*.mjs", "lib/**/*.mjs", "vite/**/*.mjs", "astro/**/*.mjs", "test/**/*.mjs", "bench/**/*.mjs"]
    },
    "site": {
      "entry": ["src/pages/**/*.astro", "src/lib/engine-worker.mjs", "test/*.mjs", "headers.mjs"],
      "project": ["src/**/*.{mjs,astro}", "test/**/*.mjs"],
      // buffer is the polyfill engine-worker.mjs installs as globalThis.Buffer for the
      // compatibility build; nothing imports it by name, so knip cannot see it is used.
      // The vendored engines in vendor/image/ import @emnapi/core, @emnapi/runtime and
      // @napi-rs/wasm-runtime directly, and knip resolves those imports on its own now that
      // image.wasi-browser.js and image.wasip1-browser.js are real files again — listing them
      // here as well would be a stale no-op, so they are left off.
      "ignoreDependencies": ["buffer"]
    }
  }
}

{
  "name": "favseed",
  "version": "1.0.1",
  "description": "Generate optimized, maskable favicons from SVG with the CLI, Vite, or Astro.",
  "keywords": [
    "apple-touch-icon",
    "astro",
    "astro-integration",
    "cli",
    "favicon",
    "favicon-generator",
    "favicons",
    "ico",
    "icon",
    "maskable",
    "optimization",
    "png",
    "pwa",
    "svg",
    "vite",
    "vite-plugin",
    "webmanifest"
  ],
  "homepage": "https://favseed.cevdet.ch",
  "bugs": {
    "url": "https://github.com/cevdetch/favseed/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Cevdet Haran",
    "url": "https://cevdet.ch/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cevdetch/favseed.git"
  },
  "bin": {
    "favseed": "bin/favseed.mjs"
  },
  "workspaces": [
    "site"
  ],
  "files": [
    "bin",
    "lib",
    "astro",
    "vite",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./bin/index.d.mts",
      "default": "./bin/index.mjs"
    },
    "./core": {
      "types": "./lib/core.d.mts",
      "default": "./lib/core.mjs"
    },
    "./vite": {
      "types": "./vite/index.d.mts",
      "default": "./vite/index.mjs"
    },
    "./vite/client": {
      "types": "./vite/client.d.ts"
    },
    "./astro": {
      "types": "./astro/index.d.ts",
      "default": "./astro/index.mjs"
    },
    "./astro/middleware": "./astro/middleware.mjs",
    "./astro/Head.astro": "./astro/Head.astro",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test test/run.test.mjs test/engine.test.mjs test/pipeline.test.mjs test/config.test.mjs test/vite.test.mjs test/security.test.mjs test/zopfli.test.mjs test/svg-precision.test.mjs test/astro-middleware.test.mjs test/lazy-loading.test.mjs test/astro-dev.test.mjs test/bytes.test.mjs test/write-failures.test.mjs test/bench-corpus.test.mjs test/bench-metrics.test.mjs test/bench-wasm-parity.test.mjs test/bench-compare.test.mjs test/quality.test.mjs test/resolve.test.mjs test/docs.test.mjs",
    "test:astro": "node --test test/astro.test.mjs",
    "bench": "bun bench/bench.mjs",
    "lint": "oxlint . && knip",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./astro/Head.astro ./astro/middleware ."
  },
  "dependencies": {
    "@napi-rs/image": "1.16.0",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@gfx/zopfli": "1.0.15",
    "@types/node": "^26.6.6",
    "knip": "6.44.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "peerDependencies": {
    "astro": "^7.3.5",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.5"
}
